Method without arguments and with single return value.
---
// Method records a call of Method and returns its set results.
func (_mck *MyMock) Method() error {
	_mck.t.Helper()
	var _args []any
	_rets := _mck.Called(_args...)
	if len(_rets) != 1 {
		_mck.t.Fatal("the number of mocked method returns does not match")
	}

	var _r0 error
	switch _v := _rets.Get(0).(type) {
	case func() error:
		_r0 = _v()
	case error:
		_r0 = _v
	case nil:
	default:
		_mck.t.Fatalf("Method return 0 is %T, not error", _v)
	}
	return _r0
}